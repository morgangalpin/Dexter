// #710-002 Split Gear Bottom -- parametric source (DC-2).
// The lower half of the split output bevel gear: it presses into the Split
// Gear Top (008.6 step 8) and carries the apex-side half of the 20 bevel
// teeth. Tooth clocking against the Top half is set during assembly by
// driving brads through the four radial holes (008.6 steps 8-9).
//
// STRUCTURE -- this mirrors how the part was actually authored. The reference
// STL is an assembly export holding two *unmerged* solids, which
//   scadmesh segment 710-002_SplitGearBottom.stl
// separates: a turned body (Ø27, z 4..22, 5732.609 mm3, tessellated at
// 3.85 tris/mm2) and a tooth crown (Ø34.81, z 18.5..27.368, 1619.975 mm3, at
// 6.91 tris/mm2). They sum to the 7352.584 mm3 the whole file encloses. The
// two densities are the giveaway: a single body is never meshed two ways, so
// these were separate solids unioned only at export. This file rebuilds them
// the same way -- revolve a body, revolve a crown, slot the crown, drill the
// brads -- rather than carving one blank.
//
// Both profiles are measured, not inferred from diameters and face heights:
//   scadmesh segment ... --out body.stl --keep 0
//   scadmesh profile body.stl --axis z --simplify 0.005
// That is what carries the convex flank between the Ø17 stub and the Ø27
// wall, which no list of diameters can express.
//
// Nothing here is a generated gear. An earlier revision intersected a BOSL2
// bevel_gear with the crown and cut no slots at all: with the pitch apex on
// the axis at z 7 and a 45-degree pitch angle, that gear's teeth stand at
// r ~19, while the crown's material lies between r 12.2 and r 16.2, so the
// intersection met only the gear's solid hub. The teeth are measured instead.

include <diff_params.scad>
include <BOSL2/std.scad>

/* [Hidden] */

// ---------------------------------------------------------------- body ----
// Measured meridional profile of the turned body, [r, z]. Walk it from the
// bottom bore lip: up the funnel, out through the bore ladder, across the top
// face, down the Ø27 wall, through the convex flank, and back along the stub.
//
// Axial positions come from a single meridional section, which measures them
// exactly -- facets run parallel to the axis, so they cannot bias a height.
// Radii on the turned surfaces are circle fits over full horizontal sections
// (`scadmesh slice`), which average the facets out; a single cut reads a
// bore's *inscribed* radius, low by r*(1 - cos(pi/n)).
//
// Two things measured on this section are not turned features and are not
// carried here. A 0.003 mm wall at Ø13 spanning z 4..13 is one of the
// assembly export's zero-thickness internal shells. The dip to Ø24 across
// z 12.0..13.5 is the brad hole the cutting plane happens to pass through;
// it is drilled below as four discrete holes.
BODY_PROFILE = [
    [ 6.500,  4.000],   // bottom face, Ø13 bore mouth
    [ 6.500,  4.500],   // Ø13 wall -- the lip inside the bottom opening
    [ 6.250,  4.500],   // step in to the funnel mouth, 0.25 mm wide
    [ 4.250,  6.500],   // 45-degree funnel down to the wire bore
    [ 4.250, 13.500],   // Ø8.5 wire bore
    [ 6.000, 13.500],   // Ø12 MR128 seat
    [ 6.000, 17.000],
    [ 9.000, 17.000],   // Ø18 sleeve bore
    [ 9.000, 21.000],
    [12.000, 21.000],   // Ø24 mouth (buried: the crown's Ø23 bore is smaller)
    [12.000, 22.000],
    [13.500, 22.000],   // top face, outer
    [13.500, 11.000],   // Ø27 wall
    [12.900, 10.692],   // convex flank, stub-ward
    [12.292, 10.399],
    [11.677, 10.124],
    [11.054,  9.865],
    [10.424,  9.623],
    [ 9.789,  9.398],
    [ 9.135,  9.184],
    [ 9.000,  9.119],
    [ 8.877,  9.035],
    [ 8.767,  8.933],
    [ 8.674,  8.816],
    [ 8.599,  8.687],
    [ 8.544,  8.548],
    [ 8.511,  8.402],
    [ 8.500,  8.253],
    [ 8.500,  4.000],   // Ø17 wire-guide stub
];

// The bottom lip, stated once because it is easy to lose in simplification:
// the Ø13 mouth is a straight wall from the bottom face to z 4.5, and the
// funnel starts 0.25 mm inboard of it. Sections read Ø13.000 (rms 0.0000) up
// to z 4.45 and the funnel at r 6.1998 by z 4.55; the funnel's 45 degrees
// extrapolate back to r 6.25 at z 4.5 exactly.

// Brad holes: four radial Ø1.5 holes on Ø27, floored at Ø24. The meridional
// section reads the hole at 0 degrees as a 1.496 mm tall notch spanning
// z 12.002..13.498 at r 12.000 -- a Ø1.5 bore centred at z 12.75, drilled to
// a radius of 12. The #680-001 brad (BRAD_D = 1.8) is larger, so it presses in.
BRAD_HOLE_D = 1.5;
BRAD_Z      = 12.75;
BRAD_FLOOR  = 12.0;     // drilled depth, as a radius
BRAD_A      = [0, 90, 180, 270];
assert(BRAD_D > BRAD_HOLE_D, "brad must be an interference fit in its hole");

// --------------------------------------------------------------- crown ----
// The crown is two revolved profiles plus 20 teeth standing between them:
// CROWN_PROFILE is the envelope the tooth tips reach, ROOT_PROFILE is the
// blank they stand on. Every surface below is a measured cone.
//
//   outer tip cone  r = z - 7.000           45 deg, apex on the axis at z 7
//   top face        r = 45.452 - 1.14900 z
//   root cone       r = 33.5244 - 0.84876 z apex on the axis at z 39.50
//   inner cone      r = z - 13.350          45 deg, apex on the axis at z 13.35
//
// The root cone is a least-squares fit through the slot-centre radius at
// eight heights, not a two-point slope: fitting it by eye from its ends left
// it 0.023 mm small over the whole flank, small but systematic.
//
// The two 45-degree cones are parallel, which is what gives each tooth an
// inside face parallel to its outside face; and the inner cone starts not at
// the top face but exactly at the top edge of the Ø23 bore, at
// (11.500, 24.846), so bore and cone share that edge.
//
// Three intersections fall out of those four equations and all three are
// confirmed by measurement rather than assumed:
//   tip cone x top face    z 24.408, r 17.408  -- the largest diameter, Ø34.81
//   tip cone x root cone   z 21.920, r 14.920  -- where the teeth begin
//   root cone x inner cone z 25.354, r 12.004  -- where the slots break through
// That last one matters: sections return one lobed ring up to z 25.30 and 20
// separate prongs from z 25.32, so the slots do *not* have a floor. They end
// where the root cone dives inside the bore cone, at the computed z 25.342.
// Reading that transition as a flat slot floor -- which loop counting alone
// invites, since a lobed ring is still a single loop -- left an earlier
// revision with a full-radius ring wherever the teeth should have been
// separated, wrong by 1.9 mm at the worst point.
CROWN_BORE_D = BRG_6703[1];     // Ø23, the 6703 outer race
CROWN_Z0     = 18.500;          // crown's bottom face
CROWN_CONE_Z = 24.846;          // top edge of the bore = foot of the inner cone
Z_TOP        = 27.368;          // prong tip truncation plane

// The envelope the tooth tips reach.
CROWN_PROFILE = [
    [CROWN_BORE_D / 2, CROWN_Z0],       // Ø23 bore, bottom
    [17.405, 24.405],                   // outer corner -- Ø34.81, the part's
                                        // largest diameter, on the outer cone
    [14.017, Z_TOP],                    // top face, at the truncation plane
    [CROWN_BORE_D / 2, CROWN_CONE_Z],   // foot of the inner cone
];

// The blank the teeth stand on: the same bore and tip cone, but turning onto
// the root cone at z 21.909 instead of carrying on to the outer corner.
CROWN_ROOT_Z = 21.920;
ROOT_PROFILE = [
    [CROWN_BORE_D / 2, CROWN_Z0],       // Ø23 bore, bottom
    [14.920, CROWN_ROOT_Z],             // tip cone meets root cone
    [12.004, 25.354],                   // root cone meets inner cone
    [CROWN_BORE_D / 2, CROWN_CONE_Z],   // foot of the inner cone
];

// ---------------------------------------------------------------- teeth ---
// Tooth cross-sections, measured. Each entry is one prong's outline at the
// matching height in TOOTH_Z, rotated so the tooth's angular midpoint is at
// 0 degrees -- those midpoints land on exact multiples of 360/20 at every
// height sampled, so the array needs no clocking correction.
//
// Stored as each outline's convex hull rather than a thinned copy of it. The
// hull is what `hull()` below would compute anyway, so no shape is lost, and
// unlike dropping every k-th point it cannot discard an extreme -- a first
// attempt did exactly that and left every prong 0.09 mm short of the tip.
//
// Lofting between sections is exact for the two surfaces that matter most
// here. The inner cone and the top face are both ruled, so their radius is
// linear in z and linear interpolation reproduces them with no error at all.
// Only the flanks are approximated between samples, and they are gently
// curved: fitting them with a single plane leaves 0.06 mm rms, which is why
// they are sampled rather than fitted.
TOOTH_Z = [22.300, 22.700, 23.100, 23.500, 23.900, 24.200, 24.405, 24.700, 25.100, 25.340, 25.700, 26.100, 26.500, 26.900, 27.150, 27.300, 27.360];
