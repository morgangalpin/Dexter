// #720-003 Diff End Pulley — parametric source (DC-2).
// GT2 40T input pulley epoxied onto the 96 mm CF rod, 6 mm from the tip
// (008.6 step 16).
//
// Authored in the reference mesh's own coordinates (z 17.500 .. 27.750), so
// every number below is a measurement rather than a derived offset and the
// part can be compared to 720-003_DiffEndPulley.stl without alignment.
// Z0 carries that origin for the assembly, which wants the part based at 0.
//
// Built the way the reference was built, and in this order:
//   1. revolve the measured meridional profile           -> the turned body
//   2. extrude one measured tooth sector, 40 copies      -> the GT2 band
//   3. cut the bore, the glue lobes, and the web slots   -> the through work
//
// The tooth band is a straight prism, not a loft: the tooth section measured
// at z = 23.5 is identical at every height between the flanges, so one
// extrusion reproduces it exactly. That is the difference between this part
// and 710-002, whose crown is conical and had to be lofted.
//
// Measured with scadmesh (slice --full outline analysis, profile, segment).
// Unlike 710-001/710-002 this reference is a single merged solid, so both
// directions of `dist` are meaningful against it.
//
// Verification, and what the section checks can and cannot show. Because the
// part is authored in the reference frame, a station quoted at it is a
// reference-frame z: the tooth section measured above at z = 23.5 is the
// part-local 6.000 plus Z0. `teeth --band 11.5,12.7 --slice-at 23.5` finds the
// 40 GT2 peaks on this render and on the reference; a station of 6.000 sections
// empty space 11.5 mm below the part and finds none on either mesh. One caution
// on the station: OpenSCAD's ASCII STL carries six significant digits, about
// 1e-4 mm at this radius, which is coarse enough that the section of the fine
// tooth polyline fails to close at some heights and reports no peaks at all.
// Exported as binary the count is 40 at every station between the flanges, and
// z = 23.5 reads 40 either way.
//
// `compare` cannot reach its 0.001 mm default tolerance here, and no change to
// this geometry would let it. Its radial checks match a histogram run of the
// reference's vertex radii against the nearest candidate vertex radius, and at
// the default 0.05 mm bin the whole tooth flank merges into one run whose mean,
// Ø23.677, is not a feature and carries no vertex on either mesh: the reference
// compared with itself fails that check by 0.044 mm, against this render's
// 0.038 mm. What the surfaces agree to is 0.0008 mm mean and 0.0056 mm at the
// 99th percentile, worst 0.030 mm at the glue-lobe edge (`dist`), and the
// section at z = 23.5 reproduces the reference's root Ø23.395, tip Ø24.968 and
// area 456.929 mm2 to within 0.0003 mm2.

include <diff_params.scad>

/* [Hidden] */
Z0 = 17.500;    // reference-frame z of the part's bottom face
Z1 = 27.750;    // reference-frame z of the top face

// Meridional outline, measured (scadmesh profile --simplify 0.005, 23 of 85
// points, area within 0.04% of the section). Revolving this reproduces the
// boss roundover, the web fillet and both flanges exactly; no radius or
// tangency is inferred. The belt band sits at the tooth ROOT radius here —
// the teeth are added on top of it in step 2.
BODY_PROFILE = [
    [ 4.000, 17.500],   // Ø8 bore, bottom
    [ 3.994, 27.750],   // Ø8 bore, top
    [13.000, 27.750],   // top face, Ø26 flange
    [12.994, 27.250],   // top flange underside
    [11.701, 27.250],   // step in to the tooth root
    [11.699, 26.899],
    [11.701, 19.750],   // root band, 7.5 mm of belt engagement
    [12.994, 19.750],   // bottom flange, top face
    [12.994, 19.000],   // bottom flange, Ø26 rim
    [10.000, 19.000],   // flange underside, in to Ø20
    [ 9.860, 18.812],   // web fillet down to the boss shoulder
    [ 9.695, 18.672],
    [ 9.504, 18.571],
    [ 9.296, 18.513],
    [ 9.134, 18.500],
    [ 5.000, 18.500],   // boss shoulder, Ø10
    [ 5.000, 18.000],
    [ 4.983, 17.871],   // boss roundover, R0.5 about (4.500, 18.000)
    [ 4.933, 17.750],
    [ 4.854, 17.646],
    [ 4.750, 17.567],
    [ 4.629, 17.517],
    [ 4.494, 17.500],
];

