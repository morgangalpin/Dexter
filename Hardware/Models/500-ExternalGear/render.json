    {"kind": "clash", "id": "clash-stator-bearing_upper", "after": ["assembly-echo"], "scad": "exgear_assembly.scad", "a": "stator", "b": "bearing_upper", "out": "out/clash-stator-bearing_upper.stl"},
    {"kind": "clash", "id": "clash-stator-flexspline", "after": ["assembly-echo"], "scad": "exgear_assembly.scad", "a": "stator", "b": "flexspline", "out": "out/clash-stator-flexspline.stl"},
