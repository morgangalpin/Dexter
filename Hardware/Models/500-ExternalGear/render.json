    {"kind": "render", "id": "assembly-echo", "scad": "exgear_assembly.scad", "out": "out/assembly.echo",
     "note": "An echo export evaluates every assert in the assembly without meshing anything. Its log is the file the checks after it read their values from."},
    {"kind": "gear_fit", "id": "gear-fit-511-002", "after": ["assembly-echo"], "config": "revised",
     "scad": "511-002_ExGearStatorHolder.scad", "nominal_out": "out/revised/511-002-nominal.bin.stl", "fitted_out": "out/revised/511-002.bin.stl",
     "gear": "../Reference/meshes/500-ExternalGear/510-001_ExternalGear.stl", "echo_file": "out/assembly.echo", "echo_name": "stator_on_gear",
